rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsProfile(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validProfile() {
      let data = request.resource.data;
      return data.keys().hasAll(['displayName', 'email', 'photoURL', 'locationId', 'role', 'createdAt', 'stats'])
        && !('location' in data)
        && (data.displayName == null || data.displayName is string)
        && (data.email == null || data.email is string)
        && (data.photoURL == null || data.photoURL is string)
        && (data.locationId == null || data.locationId in [
          'Campbellsport', 'Downtown', 'New Berlin', 'Berlin', 'Kiel',
          'Columbus', 'Wrightstown', 'Amherst', 'Kewaskum Fulfillment', 'Kewaskum Manufacturing'
        ])
        && data.role in ['employee', 'admin']
        && data.createdAt is timestamp
        && data.stats is map;
    }
    function initialStats() {
      return request.resource.data.stats == {
        'currentStreak': 0, 'longestStreak': 0,
        'totalPoints': 0, 'challengesPlayed': 0
      };
    }
    match /users/{uid} {
      allow get: if ownsProfile(uid);
      allow create: if ownsProfile(uid) && validProfile()
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'photoURL', 'locationId', 'role', 'createdAt', 'stats'])
        && request.resource.data.role == 'employee'
        && request.resource.data.createdAt == request.time
        && initialStats();
      // Legacy documents may initialize missing fields, but existing protected
      // values cannot be changed. Admin promotions and stats require trusted code.
      allow update: if ownsProfile(uid) && validProfile()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'photoURL', 'locationId', 'role', 'createdAt', 'stats', 'location'
        ])
        && (('role' in resource.data && request.resource.data.role == resource.data.role)
          || (!('role' in resource.data) && request.resource.data.role == 'employee'))
        && (('createdAt' in resource.data && request.resource.data.createdAt == resource.data.createdAt)
          || (!('createdAt' in resource.data) && request.resource.data.createdAt == request.time))
        && (('stats' in resource.data && request.resource.data.stats == resource.data.stats)
          || (!('stats' in resource.data) && initialStats()));
    }
    // All other client access is denied until explicitly authorized.
  }
}
